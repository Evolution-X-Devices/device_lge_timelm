cc_library_static {
    name: "libinit_lge_kona",
    recovery_available: true,
    srcs: ["init_lge_kona.cpp"],
    include_dirs: [
        "system/libbase/include",
        "system/core/init"
    ],
    shared_libs: [
        "libbase",
    ]
}

// fstab
prebuilt_etc {
	name: "fstab.zram",
	src: "fstab.zram",
	vendor: true,
}

// Init scripts
sh_binary {
        name: "init.class_main.sh",
        src: "init.class_main.sh",
        vendor: true,
}

